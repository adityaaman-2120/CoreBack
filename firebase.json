{
  "hosting": {
    "public": "firebase-public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "**", "run": { "serviceId": "coreback", "region": "us-central1" } }
    ]
  },
  "firestore": [{ "database": "(default)", "rules": "firestore.rules" }],
  "emulators": {
    "firestore": { "port": 8787 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
