# Copy to .env.local for local development. Never commit real values.

# --- Voice (server-side only) ------------------------------------------------
# AssemblyAI API key. The account needs Voice Agent API access and credit.
ASSEMBLYAI_API_KEY=

# --- Google Cloud / Firebase (server-side) -----------------------------------
# Defaults to the projectId in lib/firebase-config.json.
GOOGLE_CLOUD_PROJECT=
# Firestore database id. "(default)" unless you created a named database.
FIRESTORE_DATABASE_ID=(default)
# Path to a service-account key for local development (outside the repo).
# Not needed on Google Cloud, which provides credentials automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Sign-in origins ---------------------------------------------------------
# Comma-separated HTTPS origins allowed to create sessions in production.
# In development every http://localhost:* and http://127.0.0.1:* origin is allowed.
APP_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com

# --- Branding / links (optional) ---------------------------------------------
# Canonical public URL (used for metadata, sitemap and social previews).
SITE_URL=http://localhost:5173
# Shown on the privacy page when set.
NEXT_PUBLIC_SUPPORT_EMAIL=
