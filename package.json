{
  "name": "coreback",
  "version": "1.0.0",
  "description": "CoreBack: voice-first core-deposit recovery for repair shops.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-8080}",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app lib tests",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.6.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "type": "module",
  "overrides": {
    "uuid": "11.1.1"
  }
}
